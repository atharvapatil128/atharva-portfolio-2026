# Server-only. Set in .env.local and Vercel project environment settings.
RESEND_API_KEY=
# Verified sender in Resend; onboarding@resend.dev is for account-owner testing only.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=atharvapatil128@gmail.com

# Optional public override. Defaults to the current GA4 property in production.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-059Y2LE15Y

# Server-only. Powers the /ask assistant. Get a key from Google AI Studio
# (aistudio.google.com/apikey). Set in .env.local and in Vercel, scoped to
# Production only so preview deployments cannot spend against it.
GEMINI_API_KEY=
# Optional. Pins a specific model; defaults to the gemini-flash-latest alias.
GEMINI_MODEL=

# Server-only. Powers the Ask conversation record. See ASK-LOG-SETUP.md.
# The service role key bypasses row level security: never prefix NEXT_PUBLIC_,
# and scope it to Production only in Vercel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
